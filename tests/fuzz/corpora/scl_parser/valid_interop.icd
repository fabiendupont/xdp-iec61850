<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: BSD-2-Clause -->
<!--
  Minimal ICD for interop testing.
  Defines one IED with GOOSE, SV, and MMS control blocks.
-->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" version="2007" revision="B">
  <Header id="InteropTest" version="1.0"/>

  <Communication>
    <SubNetwork name="SubNet1" type="8-MMS">
      <ConnectedAP iedName="IED1" apName="AP1">
        <Address>
          <P type="IP">127.0.0.1</P>
          <P type="IP-SUBNET">255.255.255.0</P>
          <P type="OSI-PSEL">00000001</P>
          <P type="OSI-SSEL">0001</P>
          <P type="OSI-TSEL">0001</P>
        </Address>
        <GSE ldInst="LD0" cbName="gcb01">
          <Address>
            <P type="MAC-Address">01-0C-CD-01-00-01</P>
            <P type="APPID">0001</P>
            <P type="VLAN-ID">100</P>
            <P type="VLAN-PRIORITY">4</P>
          </Address>
          <MinTime unit="s" multiplier="m">4</MinTime>
          <MaxTime unit="s" multiplier="m">1000</MaxTime>
        </GSE>
        <SMV ldInst="LD0" cbName="svCB01">
          <Address>
            <P type="MAC-Address">01-0C-CD-04-00-01</P>
            <P type="APPID">4000</P>
            <P type="VLAN-ID">100</P>
            <P type="VLAN-PRIORITY">4</P>
          </Address>
        </SMV>
      </ConnectedAP>
    </SubNetwork>
  </Communication>

  <IED name="IED1" manufacturer="xdp-iec61850">
    <Services>
      <DynAssociation/>
      <GetDirectory/>
      <GetDataObjectDefinition/>
      <GetDataSetValue/>
      <DataSetDirectory/>
      <ReadWrite/>
      <GOOSE max="1"/>
      <SMVsc max="1"/>
    </Services>
    <AccessPoint name="AP1">
      <Server>
        <Authentication/>
        <LDevice inst="LD0">
          <LN0 lnClass="LLN0" inst="" lnType="LLN0_Type">
            <DataSet name="dsGOOSE">
              <FCDA ldInst="LD0" lnClass="GGIO" lnInst="1" doName="SPCSO1" daName="stVal" fc="ST"/>
              <FCDA ldInst="LD0" lnClass="GGIO" lnInst="1" doName="Ind1" daName="stVal" fc="ST"/>
              <FCDA ldInst="LD0" lnClass="GGIO" lnInst="1" doName="AnIn1" daName="mag.f" fc="MX"/>
              <FCDA ldInst="LD0" lnClass="GGIO" lnInst="1" doName="AnIn1" daName="q" fc="MX"/>
            </DataSet>
            <DataSet name="dsSV">
              <FCDA ldInst="LD0" lnClass="MMXU" lnInst="1" doName="PhV" daName="phsA.cVal.mag.f" fc="MX"/>
              <FCDA ldInst="LD0" lnClass="MMXU" lnInst="1" doName="PhV" daName="phsA.q" fc="MX"/>
              <FCDA ldInst="LD0" lnClass="MMXU" lnInst="1" doName="PhV" daName="phsB.cVal.mag.f" fc="MX"/>
              <FCDA ldInst="LD0" lnClass="MMXU" lnInst="1" doName="PhV" daName="phsB.q" fc="MX"/>
            </DataSet>
            <GSEControl name="gcb01" datSet="dsGOOSE" appID="IED1_GOOSE" confRev="1" type="GOOSE"/>
            <SampledValueControl name="svCB01" datSet="dsSV" smvID="IED1_SV" confRev="1" smpRate="80" nofASDU="1" multicast="true"/>
          </LN0>
          <LN lnClass="LPHD" inst="1" lnType="LPHD_Type"/>
          <LN lnClass="GGIO" inst="1" lnType="GGIO_Type"/>
          <LN lnClass="MMXU" inst="1" lnType="MMXU_Type"/>
        </LDevice>
      </Server>
    </AccessPoint>
  </IED>

  <DataTypeTemplates>
    <LNodeType id="LLN0_Type" lnClass="LLN0">
      <DO name="Beh" type="INS_Type"/>
      <DO name="Health" type="INS_Type"/>
      <DO name="Mod" type="INC_Type"/>
      <DO name="NamPlt" type="LPL_Type"/>
    </LNodeType>
    <LNodeType id="LPHD_Type" lnClass="LPHD">
      <DO name="PhyHealth" type="INS_Type"/>
      <DO name="PhyNam" type="DPL_Type"/>
      <DO name="Proxy" type="SPS_Type"/>
    </LNodeType>
    <LNodeType id="GGIO_Type" lnClass="GGIO">
      <DO name="Beh" type="INS_Type"/>
      <DO name="SPCSO1" type="SPC_Type"/>
      <DO name="Ind1" type="SPS_Type"/>
      <DO name="AnIn1" type="MV_Type"/>
    </LNodeType>
    <LNodeType id="MMXU_Type" lnClass="MMXU">
      <DO name="Beh" type="INS_Type"/>
      <DO name="PhV" type="WYE_Type"/>
    </LNodeType>
    <DOType id="SPC_Type" cdc="SPC">
      <DA name="stVal" bType="BOOLEAN" fc="ST" dchg="true"/>
      <DA name="q" bType="Quality" fc="ST" qchg="true"/>
      <DA name="t" bType="Timestamp" fc="ST"/>
      <DA name="ctlModel" bType="Enum" type="CtlModelKind" fc="CF"/>
    </DOType>
    <DOType id="SPS_Type" cdc="SPS">
      <DA name="stVal" bType="BOOLEAN" fc="ST" dchg="true"/>
      <DA name="q" bType="Quality" fc="ST" qchg="true"/>
      <DA name="t" bType="Timestamp" fc="ST"/>
    </DOType>
    <DOType id="MV_Type" cdc="MV">
      <DA name="mag" type="AnalogueValue_Type" bType="Struct" fc="MX" dchg="true"/>
      <DA name="q" bType="Quality" fc="MX" qchg="true"/>
      <DA name="t" bType="Timestamp" fc="MX"/>
    </DOType>
    <DOType id="INS_Type" cdc="INS">
      <DA name="stVal" bType="INT32" fc="ST" dchg="true"/>
      <DA name="q" bType="Quality" fc="ST" qchg="true"/>
      <DA name="t" bType="Timestamp" fc="ST"/>
    </DOType>
    <DOType id="INC_Type" cdc="INC">
      <DA name="stVal" bType="INT32" fc="ST" dchg="true"/>
      <DA name="q" bType="Quality" fc="ST" qchg="true"/>
      <DA name="t" bType="Timestamp" fc="ST"/>
      <DA name="ctlModel" bType="Enum" type="CtlModelKind" fc="CF"/>
    </DOType>
    <DOType id="WYE_Type" cdc="WYE">
      <SDO name="phsA" type="CMV_Type"/>
      <SDO name="phsB" type="CMV_Type"/>
      <SDO name="phsC" type="CMV_Type"/>
    </DOType>
    <DOType id="CMV_Type" cdc="CMV">
      <DA name="cVal" type="Vector_Type" bType="Struct" fc="MX" dchg="true"/>
      <DA name="q" bType="Quality" fc="MX" qchg="true"/>
      <DA name="t" bType="Timestamp" fc="MX"/>
    </DOType>
    <DOType id="LPL_Type" cdc="LPL">
      <DA name="vendor" bType="VisibleString255" fc="DC"/>
      <DA name="swRev" bType="VisibleString255" fc="DC"/>
      <DA name="d" bType="VisibleString255" fc="DC"/>
    </DOType>
    <DOType id="DPL_Type" cdc="DPL">
      <DA name="vendor" bType="VisibleString255" fc="DC"/>
    </DOType>
    <DAType id="AnalogueValue_Type">
      <BDA name="f" bType="FLOAT32"/>
    </DAType>
    <DAType id="Vector_Type">
      <BDA name="mag" type="AnalogueValue_Type" bType="Struct"/>
      <BDA name="ang" type="AnalogueValue_Type" bType="Struct"/>
    </DAType>
    <EnumType id="CtlModelKind">
      <EnumVal ord="0">status-only</EnumVal>
      <EnumVal ord="1">direct-with-normal-security</EnumVal>
      <EnumVal ord="2">sbo-with-normal-security</EnumVal>
      <EnumVal ord="3">direct-with-enhanced-security</EnumVal>
      <EnumVal ord="4">sbo-with-enhanced-security</EnumVal>
    </EnumType>
  </DataTypeTemplates>
</SCL>
