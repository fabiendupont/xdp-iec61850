    <directive file="include/iec61850/containers/fixed_string.h" linenr="63" str="#define IEC61850_DEFINE_FIXED_STRING(NAME, CAPACITY) typedef struct NAME { char data[(CAPACITY) + 1U]; size_t len; } NAME##_t; static inline void NAME##_init(NAME##_t *s) { iec61850_fixed_string_init_raw(s-&gt;data, &amp;s-&gt;len); } static inline int NAME##_assign(NAME##_t *s, const char *str) { return iec61850_fixed_string_assign_raw(s-&gt;data, &amp;s-&gt;len, (CAPACITY), str); } static inline int NAME##_assign_n(NAME##_t *s, const char *str, size_t n) { return iec61850_fixed_string_assign_n_raw(s-&gt;data, &amp;s-&gt;len, (CAPACITY), str, n); } static inline void NAME##_clear(NAME##_t *s) { iec61850_fixed_string_clear_raw(s-&gt;data, &amp;s-&gt;len); } static inline const char *NAME##_cstr(const NAME##_t *s) { return s-&gt;data; } static inline size_t NAME##_len(const NAME##_t *s) { return s-&gt;len; } static inline size_t NAME##_capacity(const NAME##_t *s) { (void)s; return (CAPACITY); } static inline bool NAME##_empty(const NAME##_t *s) { return s-&gt;len == 0U; } static inline bool NAME##_equal(const NAME##_t *a, const NAME##_t *b) { return iec61850_fixed_string_equal_raw(a-&gt;data, a-&gt;len, b-&gt;data, b-&gt;len); } static inline bool NAME##_equal_cstr(const NAME##_t *s, const char *cstr) { return iec61850_fixed_string_equal_cstr_raw(s-&gt;data, s-&gt;len, cstr); } static inline int NAME##_compare(const NAME##_t *a, const NAME##_t *b) { if (a == NULL || b == NULL) { return (a == b) ? 0 : (a == NULL) ? -1 : 1; } return iec61850_fixed_string_compare_raw(a-&gt;data, a-&gt;len, b-&gt;data, b-&gt;len); }">
